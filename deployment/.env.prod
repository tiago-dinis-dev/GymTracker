# Production environment variables for GymTracker
# Replace placeholders with secure values before deploying.
ASPNETCORE_ENVIRONMENT=Production

# Database connections (use managed DB in prod if possible)
DEFAULT_CONNECTION=Data Source=/data/gymtracker.db
DEFAULT_CONNECTION_AI=Data Source=/data/gymtracker_ai.db

# JWT signing key - keep this secret (DO NOT commit real keys to git)
JWT__KEY=your-production-jwt-key
JWT__ISSUER=GymTracker
JWT__AUDIENCE=GymTracker

# AI agent configuration
FITNESS_AGENT__GITHUBTOKEN=ollama
FITNESS_AGENT__MODELID=qwen2.5:7b
FITNESS_AGENT__ENDPOINT=http://ollama:11434

# Frontend proxy target (used when building the frontend for prod)
VITE_API_PROXY_TARGET=http://backend:8080
